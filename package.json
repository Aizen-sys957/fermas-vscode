{
  "name": "fermas",
  "displayName": "Fermas — Code Execution Visualizer",
  "description": "Step through any program and watch the call stack, heap and event-loop queues, right beside your code.",
  "version": "0.1.0",
  "publisher": "fermas",
  "repository": {
    "type": "git",
    "url": "https://github.com/Aizen-sys957/fermas-vscode.git"
  },
  "engines": {
    "vscode": "^1.88.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Aizen-sys957/fermas-vscode.git"
  },
  "categories": [
    "Education",
    "Programming Languages",
    "Debuggers",
    "Other"
  ],
  "keywords": [
    "visualizer",
    "education",
    "algorithm",
    "concurrency",
    "event-loop",
    "python",
    "rust",
    "javascript"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onView:fermas.visualizerView",
    "onView:fermas.visualizerViewSecondary"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "fermas-explorer",
          "title": "Fermas",
          "icon": "media/icon.svg"
        }
      ],
      "secondarySidebar": [
        {
          "id": "fermas-secondary",
          "title": "Fermas",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "fermas-explorer": [
        {
          "type": "webview",
          "id": "fermas.visualizerView",
          "name": "Visualizer"
        }
      ],
      "fermas-secondary": [
        {
          "type": "webview",
          "id": "fermas.visualizerViewSecondary",
          "name": "Visualizer"
        }
      ]
    },
    "commands": [
      {
        "command": "fermas.visualize",
        "title": "Fermas: Visualize Active Code Execution",
        "icon": "$(play)"
      },
      {
        "command": "fermas.openPanel",
        "title": "Fermas: Open Visualizer in Editor Tab",
        "icon": "$(open-preview)"
      },
      {
        "command": "fermas.openCurriculum",
        "title": "Fermas: Browse CS Curriculum & Puzzles",
        "icon": "$(book)"
      },
      {
        "command": "fermas.stepForward",
        "title": "Fermas: Step Forward",
        "icon": "$(arrow-right)"
      },
      {
        "command": "fermas.stepBack",
        "title": "Fermas: Step Back",
        "icon": "$(arrow-left)"
      },
      {
        "command": "fermas.resetTrace",
        "title": "Fermas: Reset Simulation",
        "icon": "$(debug-restart)"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "fermas.visualize",
          "when": "editorTextFocus",
          "group": "fermas@1"
        }
      ],
      "view/title": [
        {
          "command": "fermas.openPanel",
          "when": "view == fermas.visualizerView || view == fermas.visualizerViewSecondary",
          "group": "navigation@1"
        },
        {
          "command": "fermas.openCurriculum",
          "when": "view == fermas.visualizerView || view == fermas.visualizerViewSecondary",
          "group": "navigation@2"
        },
        {
          "command": "fermas.visualize",
          "when": "view == fermas.visualizerView || view == fermas.visualizerViewSecondary",
          "group": "navigation@3"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "node esbuild.js && npm run compile:webview",
    "compile:webview": "npm --prefix webview-ui run build",
    "watch": "node esbuild.js --watch",
    "watch:webview": "npm --prefix webview-ui run watch",
    "install:webview": "npm --prefix webview-ui install",
    "typecheck:webview": "npm --prefix webview-ui run typecheck",
    "serve:curriculum": "node server/demoServer.js",
    "package": "npx @vscode/vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.20.0",
    "typescript": "^5.3.3"
  }
}
